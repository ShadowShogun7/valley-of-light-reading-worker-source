# Isolated Valley of Light staging only.
# Never copy production Supabase, WooCommerce, ECPay, or signing credentials
# into this file or source /Users/novaos/.openclaw/workspace/.env for staging.
NODE_ENV=production
VALLEY_RUNTIME_ENV=staging
VALEOFLIGHT_APP_BASE_URL=https://valley-of-light-app-staging.vercel.app

# Fresh schema-only staging Supabase project.
VALLEY_SUPABASE_URL=
VALLEY_SUPABASE_SERVICE_ROLE_KEY=

# Generate a staging-only secret of at least 32 random bytes. Its exact value
# must also be configured as VOL_ACCESS_SIGNING_SECRET on WordPress staging.
VALLEY_ACCESS_SIGNING_SECRET=
VALLEY_ACCESS_GRANT_TTL_DAYS=30

# Staging policy identifiers. The checkout value must match the candidate
# WordPress bridge's current stamped cohort. It is for staging evidence only
# and is not approval to reuse this identifier in production.
VALLEY_INTAKE_VERSION=relationship-intake-v1
VALLEY_GENERATION_CONSENT_VERSION=staging-generation-consent-v1
VALLEY_CHECKOUT_TERMS_VERSION=commerce-terms-2026-07-26-draft
VALLEY_ACCEPTED_CHECKOUT_TERMS_VERSIONS=commerce-terms-2026-07-26-draft
VALLEY_RETENTION_POLICY_VERSION=staging-reading-retention-v1
VALLEY_EMAIL_QUEUE_MAX_AGE_MINUTES=15

# Sanitized WordPress staging only. The REST and access-email URLs must share
# the same staging host.
VALEOFLIGHT_WOOCOMMERCE_REST_API_URL=
VALEOFLIGHT_WOOCOMMERCE_CONSUMER_KEY=
VALEOFLIGHT_WOOCOMMERCE_CONSUMER_SECRET=
VALEOFLIGHT_WOOCOMMERCE_WEBHOOK_SECRET=
VALEOFLIGHT_WOOCOMMERCE_PRODUCT_ID=
VALEOFLIGHT_WOOCOMMERCE_EXPECTED_CURRENCY=TWD
VALEOFLIGHT_WOOCOMMERCE_EXPECTED_AMOUNT_MINOR=1280
VALEOFLIGHT_WORDPRESS_EMAIL_API_URL=

# Generate a second staging-only secret. Its exact value must also be
# configured as VOL_APP_TO_WORDPRESS_SIGNING_SECRET on WordPress staging, and
# it must differ from VALLEY_ACCESS_SIGNING_SECRET.
VALEOFLIGHT_WORDPRESS_EMAIL_SIGNING_SECRET=

# Vercel Cron and missed-webhook reconciliation.
CRON_SECRET=
VALLEY_WOOCOMMERCE_RECONCILIATION_BATCH_SIZE=25
VALLEY_WOOCOMMERCE_RECONCILIATION_LOOKBACK_HOURS=48
VALLEY_WOOCOMMERCE_RECONCILIATION_MAX_AGE_MINUTES=30
VALLEY_WOOCOMMERCE_RECONCILIATION_WINDOW_LAG_SECONDS=60

# Separately deployed staging calculation worker.
VALLEY_WORKER_URL=
VALLEY_WORKER_SIGNING_SECRET=
VALLEY_AGPL_SOURCE_URL=
VALLEY_AGPL_SOURCE_SHA256=

# The unauthenticated local result prototype must stay disabled.
VALLEY_ENABLE_LOCAL_RESULT_PROTOTYPE=0
