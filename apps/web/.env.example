# Public, non-secret server configuration
NODE_ENV=development
VALLEY_RUNTIME_ENV=development
VALEOFLIGHT_APP_BASE_URL=https://app.valeoflight.com
VALLEY_ACCESS_GRANT_TTL_DAYS=30
VALLEY_INTAKE_VERSION=relationship-intake-v1
VALLEY_GENERATION_CONSENT_VERSION=
VALLEY_CHECKOUT_TERMS_VERSION=commerce-terms-2026-07-26-draft
# Keep the current version plus any still-payable prior order cohorts.
VALLEY_ACCEPTED_CHECKOUT_TERMS_VERSIONS=commerce-terms-2026-07-26-draft
# Required for the production health check only after the owner approves the policy.
VALLEY_RETENTION_POLICY_VERSION=
# Health fails when a due transactional email remains unattended this long.
VALLEY_EMAIL_QUEUE_MAX_AGE_MINUTES=15
VALEOFLIGHT_WOOCOMMERCE_EXPECTED_CURRENCY=TWD
VALEOFLIGHT_WOOCOMMERCE_EXPECTED_AMOUNT_MINOR=1280
VALLEY_ENABLE_LOCAL_RESULT_PROTOTYPE=0

# Supabase service access: server only, never NEXT_PUBLIC_
VALLEY_SUPABASE_URL=
VALLEY_SUPABASE_SERVICE_ROLE_KEY=

# Access-link signing: generate at least 32 random bytes. Configure the same
# value as VOL_ACCESS_SIGNING_SECRET in wp-config.php so WordPress can render
# the exact app-owned token without storing the raw token or URL.
VALLEY_ACCESS_SIGNING_SECRET=

# WooCommerce REST and signed webhook verification: server only
VALEOFLIGHT_WOOCOMMERCE_REST_API_URL=https://www.valeoflight.com/wp-json/wc/v3
VALEOFLIGHT_WOOCOMMERCE_CONSUMER_KEY=
VALEOFLIGHT_WOOCOMMERCE_CONSUMER_SECRET=
VALEOFLIGHT_WOOCOMMERCE_WEBHOOK_SECRET=
VALEOFLIGHT_WOOCOMMERCE_PRODUCT_ID=13

# Signed, narrow app-to-WordPress access-email notification. Generate a
# separate 32+ byte secret and configure its same value as
# VOL_APP_TO_WORDPRESS_SIGNING_SECRET in wp-config.php.
VALEOFLIGHT_WORDPRESS_EMAIL_API_URL=https://www.valeoflight.com/wp-json/vale-of-light/v1/access-email
VALEOFLIGHT_WORDPRESS_EMAIL_SIGNING_SECRET=

# Authenticated Vercel Cron: scans one bounded Woo REST page every 10 minutes.
# The 48-hour overlap makes delayed or missed webhook delivery recoverable.
CRON_SECRET=
VALLEY_WOOCOMMERCE_RECONCILIATION_BATCH_SIZE=25
VALLEY_WOOCOMMERCE_RECONCILIATION_LOOKBACK_HOURS=48
VALLEY_WOOCOMMERCE_RECONCILIATION_MAX_AGE_MINUTES=30
VALLEY_WOOCOMMERCE_RECONCILIATION_WINDOW_LAG_SECONDS=60

# Optional legacy Resend webhook compatibility. The production reading emails
# use WooCommerce's Processing/Completed templates and WordPress's configured
# authenticated SMTP/API transport; these values are not a launch dependency.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Worker wake-up, durable signed claim, and signed result callback.
# Production readiness fails until both values are configured.
VALLEY_WORKER_URL=
VALLEY_WORKER_SIGNING_SECRET=
# Public source release matching the deployed AGPL worker.
VALLEY_AGPL_SOURCE_URL=
VALLEY_AGPL_SOURCE_SHA256=
